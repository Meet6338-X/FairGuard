# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Generated during runs — recreate with the scripts in scripts/
data/*.csv
data/*.json
data/processed/
data/raw/
models/
mlruns/
reports/*
!reports/.gitkeep

# Data visualizations are regenerated with scripts/visualize_data.py, but the
# gallery is kept in the repo so docs/visualize.md can reference the charts.
!visualize/

# Hand-written example inputs for the --texts flag (not generated, so kept).
!data/sample_texts.csv

# Original university documents may contain personal contact details.
# This repository is public, so they stay out of version control.
*.pdf
*.docx

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
